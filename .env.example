# Framivite Backend Production Environment Variables
DATABASE_URL="postgresql://username:password@ep-your-database.neon.tech/neondb?sslmode=require"
PORT=3001
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Framivite <onboarding@resend.dev>

# Persistent Cloud Storage (Cloudinary - Free 25GB)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
